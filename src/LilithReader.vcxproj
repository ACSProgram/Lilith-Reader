<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d}</ProjectGuid>
    <RootNamespace>LilithReader</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <!-- 注意：不使用 $(SolutionDir)，build.bat 直接编译 vcxproj 时它会解析为 src\ -->
    <IntDir>$(ProjectDir)..\build\LilithReader\$(Configuration)\</IntDir>
    <OutDir>$(ProjectDir)..\bin\$(Configuration)\</OutDir>
    <TargetName>LilithReader (Debug)</TargetName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <IntDir>$(ProjectDir)..\build\LilithReader\$(Configuration)\</IntDir>
    <OutDir>$(ProjectDir)..\bin\$(Configuration)\</OutDir>
  </PropertyGroup>
  <PropertyGroup Label="Vcpkg">
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgTriplet>x64-windows-static</VcpkgTriplet>
    <VcpkgUseStatic>true</VcpkgUseStatic>
    <!-- 依赖安装根目录（不含 triplet），必须满足两个条件，理由见 ADR-010：
         1) 路径不含空格 —— meson 端口（harfbuzz）生成的链接命令行未给 /libpath:
            加引号，路径含空格会被截断成两个参数，导致 LNK1181。
         2) 不含 triplet —— vcpkg 的 MSBuild 集成把它当作安装根传给 vcpkg
            （vcpkg 内部再拼一次 triplet），同时又在 _ZVcpkgCurrentInstalledDir
            里再拼一次；写含 triplet 的路径会导致 include/lib 双重目录、找不到头文件。
         实际生效路径 = $(VcpkgInstalledDir)\$(VcpkgTriplet)。 -->
    <VcpkgInstalledDir>F:\programs\.Environment\vcpkg-roots\LilithReader</VcpkgInstalledDir>
  </PropertyGroup>
  <!-- MuPDF 兼容宏：vcpkg 的 libmupdf 端口把这些 FZ_ENABLE_ 开头的宏作为私有编译
       定义传给库（见其 CMakeLists.txt），不会传播给消费方。因此本项目必须镜像
       同样的取值，否则同一份头文件在两侧展开出不同的结构体布局（最典型的是
       fz_context 里的 icc_enabled、fz_colorspace 里的 icc 成员），
       一旦访问到受影响的成员就是静默的 ABI 错位。当前我们只通过指针传递这些
       不透明类型、未访问任何受保护成员，但镜像成本极低，杜绝后续踩雷。
       维护提示：升级 libmupdf 端口后需核对端口的 PRIVATE 定义是否变化。 -->
  <PropertyGroup Label="MuPDFCompatibility">
    <MupdfCompatDefines>FZ_ENABLE_ICC=0;FZ_ENABLE_JS=0;FZ_ENABLE_BROTLI=0;FZ_ENABLE_DOCX_OUTPUT=0;FZ_ENABLE_ODT_OUTPUT=0</MupdfCompatDefines>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>_DEBUG;_WINDOWS;$(MupdfCompatDefines);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp23</LanguageStandard>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <AdditionalOptions>%(AdditionalOptions) /utf-8 /bigobj /external:anglebrackets</AdditionalOptions>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <MinimalRebuild>false</MinimalRebuild>
      <AdditionalIncludeDirectories>$(ProjectDir)..\third_party\imgui;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>%(AdditionalDependencies);d3d11.lib;dxgi.lib;d3dcompiler.lib;Shcore.lib;imm32.lib</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>NDEBUG;_WINDOWS;$(MupdfCompatDefines);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp23</LanguageStandard>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <FavorSizeOrSpeed>Speed</FavorSizeOrSpeed>
      <Optimization>MaxSpeed</Optimization>
      <AdditionalOptions>%(AdditionalOptions) /utf-8 /bigobj /external:anglebrackets</AdditionalOptions>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalIncludeDirectories>$(ProjectDir)..\third_party\imgui;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>%(AdditionalDependencies);d3d11.lib;dxgi.lib;d3dcompiler.lib;Shcore.lib;imm32.lib</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <!-- Phase 6：应用图标资源（exe/窗口/任务栏图标） -->
    <ResourceCompile Include="app\app.rc" />
    <ClCompile Include="app\main.cpp" />
    <ClCompile Include="utils\utils.ixx" />
    <ClCompile Include="document\document.ixx" />
    <ClCompile Include="document\document.cpp" />
    <!-- Phase 3：自研画布（纯布局，可单测）与渲染调度层 -->
    <ClCompile Include="canvas\canvas.ixx" />
    <ClCompile Include="canvas\canvas.cpp" />
    <ClCompile Include="render\render.ixx" />
    <ClCompile Include="render\render.cpp" />
    <!-- Phase 4：页缓存纯策略（零依赖，可单测；render.cpp 使用） -->
    <ClCompile Include="render\page_cache.ixx" />
    <!-- Phase 5：阅读状态持久化（纯序列化 + 原子文件 I/O，可单测） -->
    <ClCompile Include="state\reader_state.ixx" />
    <ClCompile Include="state\reader_state.cpp" />
    <!-- Phase 3 起 ImPlot 已从构建中移除（自研画布取代其调试用途，见 ADR-018） -->
    <ClCompile Include="..\third_party\imgui\imgui.cpp" />
    <ClCompile Include="..\third_party\imgui\imgui_draw.cpp" />
    <ClCompile Include="..\third_party\imgui\imgui_tables.cpp" />
    <ClCompile Include="..\third_party\imgui\imgui_widgets.cpp" />
    <ClCompile Include="..\third_party\imgui\imgui_demo.cpp" />
    <ClCompile Include="..\third_party\imgui\backends\imgui_impl_dx11.cpp" />
    <ClCompile Include="..\third_party\imgui\backends\imgui_impl_win32.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
