// app.rc — 应用资源
// 目前三类：应用图标（exe 图标、窗口图标与任务栏图标）、UI 字体子集、版本资源。
// 版本资源用于让系统"打开方式"列表显示应用名（exe 缺 FileDescription 时会退回文件名）。
// 字符串值刻意全用 ASCII，规避 rc 编码问题。打开方式注册表脚本在 installer/ 下。
//
// 刻意不 #include <windows.h>：资源编译器对它的展开支持有限，这里只需要整型 ID。

#define IDI_APPICON 101
#define IDR_UIFONT  102

IDI_APPICON ICON "../../assets/icon.ico"

// UI 字体子集（ADR-048）：以 RCDATA 原样嵌入，运行时 FindResource/LoadResource 取内存交给
// ImGui（AddFontFromMemoryTTF）。不用 #embed 的原因：① 不要求 /std:c++latest；
// ② 资源在进程生命周期内一直映射着，正合 ImGui 1.92+ "字体数据须全程有效"的要求。
// 生成方式见 assets/make_font_subset.py；覆盖范围由 tests 里的 check_font_coverage.py 断言。
IDR_UIFONT RCDATA "../../assets/ui_font_subset.otf"

// 版本资源。注意 PE 的 FILEVERSION/PRODUCTVERSION 必须是 4 段纯数字，无法承载
// "1.0-rc.1" 这类预发布后缀：数字版本固定为 1,0,0,0，人类可读的版本串写进
// FileVersion/ProductVersion 字符串值。installer 的编译期校验比对的是**数字版本**
// （见 installer/LilithReader.iss 的 MyAppVersionNumeric），故两者需同步。
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Lilith Reader"
      VALUE "FileVersion", "1.0-rc.1"
      VALUE "ProductName", "Lilith Reader"
      VALUE "ProductVersion", "1.0-rc.1"
      VALUE "OriginalFilename", "LilithReader.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
